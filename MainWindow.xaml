<Window x:Class="ModelCopier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModelCopier.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1200" Height="780"
        MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource AppBgBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- 0: Top Brand Navigation Bar -->
            <RowDefinition Height="Auto"/> <!-- 1: Sub-Header Hero Banner   -->
            <RowDefinition Height="*"/>    <!-- 2: Main Workspace Grid       -->
            <RowDefinition Height="Auto"/> <!-- 3: Progress Bar              -->
            <RowDefinition Height="28"/>   <!-- 4: Bottom Status Bar         -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 0: TOP BRAND NAVIGATION BAR (BuildSmith Precision Suite)
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo (Glowing 3D Cube + BuildSmith) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34"
                            CornerRadius="8"
                            Background="#091529"
                            BorderBrush="{StaticResource AccentCyanBrush}"
                            BorderThickness="1.2"
                            Margin="0,0,12,0">
                        <!-- Stylized Geometric Cube Graphic -->
                        <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Top Facet -->
                            <Polygon Points="10,2 18,6 10,10 2,6" Fill="#00F0FF" Opacity="0.9"/>
                            <!-- Left Facet -->
                            <Polygon Points="2,6 10,10 10,18 2,14" Fill="#00B4D8" Opacity="0.75"/>
                            <!-- Right Facet -->
                            <Polygon Points="10,10 18,6 18,14 10,18" Fill="#1D4ED8" Opacity="0.85"/>
                        </Canvas>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BuildSmith"
                                   FontSize="18" FontWeight="ExtraBold"
                                   Foreground="{StaticResource AccentTealBrush}"/>
                        <TextBlock Text="PRECISION SUITE"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryLightBrush}"
                                   Margin="0,-1,0,0"/>
                    </StackPanel>

                    <!-- Build Version Badge -->
                    <Border Background="#0C1B33"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="7,3"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersion}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentCyanBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Navigation Pills (Matching Top-Right Pills in Screenshot) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="🎮  Models"
                            Style="{StaticResource InactiveNavPillStyle}"
                            Margin="0,0,4,0"/>
                    <Button Content="⚡  Replication"
                            Style="{StaticResource ActiveNavPillStyle}"
                            Margin="0,0,4,0"/>
                    <Button Content="📁  Backups"
                            Command="{Binding InquireBackupsCommand}"
                            Style="{StaticResource InactiveNavPillStyle}"
                            Margin="0,0,4,0"/>
                    <Button Content="📊  Integrity"
                            Command="{Binding InquireBackupsCommand}"
                            Style="{StaticResource InactiveNavPillStyle}"
                            Margin="0,0,4,0"/>
                    <Button Content="📜  Records"
                            Command="{Binding OpenRecordsFileCommand}"
                            Style="{StaticResource InactiveNavPillStyle}"
                            Margin="0,0,4,0"/>
                    <Button Content="⚙  Config"
                            Command="{Binding OpenConfigFileCommand}"
                            Style="{StaticResource InactiveNavPillStyle}"/>
                </StackPanel>

                <!-- Rightmost Tools: Shared Network Config & Engine Badge -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Network Config Selector / Status -->
                    <Border Background="#091830"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConfigLocationBadge}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryLightBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Button Content="Switch…"
                                    Command="{Binding SelectSharedConfigCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="10"
                                    ToolTip="Select shared models.json on an office network drive"/>
                            <Button Content="Reset"
                                    Command="{Binding ResetLocalConfigCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2"
                                    FontSize="10"
                                    Margin="4,0,0,0"
                                    Visibility="{Binding IsUsingSharedConfig, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Revert to local models.json"/>
                        </StackPanel>
                    </Border>

                    <!-- Replication Engine Badge -->
                    <Border Background="#0A1830"
                            BorderBrush="#1E3A5F"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,5"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬡ " FontSize="10" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="Tekla Replication Engine"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryLightBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 1: SUB-HEADER HERO BANNER
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource AppBgBrush}"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,12,22,12">
            <StackPanel>
                <!-- Title & Description Row -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Glowing Target Icon -->
                    <Border Grid.Column="0"
                            Width="28" Height="28"
                            CornerRadius="14"
                            Background="#092038"
                            BorderBrush="{StaticResource AccentCyanBrush}"
                            BorderThickness="1.8"
                            Margin="0,2,12,0"
                            VerticalAlignment="Top">
                        <Ellipse Width="10" Height="10"
                                 Fill="{StaticResource AccentCyanBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Tekla Model Replication &amp; Dual-Backup Manager"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="High-precision dual-target replication for Tekla Structures models. Automated incremental sync with directory integrity validation."
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,4,0,1"/>
                        <TextBlock Text="Seamless Reserve (Type 1) safety mirroring and Checker (Type 2) verification sync."
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Quick Presets Row -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="✨ " FontSize="12" Foreground="#FBBF24"/>
                        <TextBlock Text="Quick Presets:"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FBBF24"/>
                    </StackPanel>

                    <Button Content="Dual Sync (Reserve &amp; Checker)"
                            Command="{Binding SelectDualBackupCommand}"
                            Style="{StaticResource PillPresetButtonStyle}"
                            Margin="0,0,8,0"/>

                    <Button Content="Reserve Only (Type 1)"
                            Command="{Binding SelectReserveOnlyCommand}"
                            Style="{StaticResource PillPresetButtonStyle}"
                            Margin="0,0,8,0"/>

                    <Button Content="Checker Only (Type 2)"
                            Command="{Binding SelectCheckerOnlyCommand}"
                            Style="{StaticResource PillPresetButtonStyle}"/>
                </StackPanel>

                <!-- ── COMMON AUTOMATION SERVICES BAR (STACKED) ── -->
                <Border Background="{StaticResource SurfaceDarkBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,9"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <!-- Row 1: Auto-Scheduled Backup -->
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏱" FontSize="13" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <CheckBox Content="Enable Auto-Scheduled Backup"
                                          IsChecked="{Binding IsAutoBackupEnabled, Mode=TwoWay}"
                                          FontSize="11" FontWeight="SemiBold"
                                          Foreground="{StaticResource PrimaryLightBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"
                                          ToolTip="Automatically triggers full backup at set intervals for all models with [Auto] ticked in registry"/>

                                <TextBlock Text="Interval:" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox ItemsSource="{Binding AvailableIntervals}"
                                          SelectedItem="{Binding AutoBackupIntervalMinutes, Mode=TwoWay}"
                                          ItemStringFormat="{}{0} min"
                                          Width="82" Height="26"
                                          FontSize="11"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>

                                <Border Background="#091B33"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                    <TextBlock Text="{Binding NextAutoBackupText}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>

                                <CheckBox Content="Sound chime on finish"
                                          IsChecked="{Binding PlaySoundOnCompletion, Mode=TwoWay}"
                                          FontSize="10"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          VerticalAlignment="Center"
                                          ToolTip="Sound notification chime when scheduled backup completes"/>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Right"
                                       Text="Only models with [Auto] ticked in registry will be executed"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Subtle Row Divider -->
                        <Separator Margin="0,7" Background="{StaticResource BorderColorBrush}" Opacity="0.5"/>

                        <!-- Row 2: Live Incremental Backup -->
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="13" Foreground="{StaticResource AccentTealBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <CheckBox Content="Enable Live Incremental Backup"
                                          IsChecked="{Binding IsIncrementalSyncEnabled, Mode=TwoWay}"
                                          FontSize="11" FontWeight="SemiBold"
                                          Foreground="{StaticResource PrimaryLightBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"
                                          ToolTip="Automatically synchronizes modified files at set intervals during this session for models with [Incr] ticked in registry"/>

                                <TextBlock Text="Interval:" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox ItemsSource="{Binding AvailableIncrementalIntervals}"
                                          SelectedItem="{Binding IncrementalIntervalMinutes, Mode=TwoWay}"
                                          ItemStringFormat="{}{0} min"
                                          Width="82" Height="26"
                                          FontSize="11"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>

                                <Border Background="#091F38"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="{Binding NextIncrementalSyncText}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource AccentTealBrush}"/>
                                </Border>

                                <Button Content="⚡ Sync Now"
                                        Command="{Binding SyncIncrementalNowCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4"
                                        FontSize="10"
                                        ToolTip="Immediately synchronize modified files for all [Incr] models"
                                        Margin="0,0,10,0"/>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Right"
                                       Text="Only models with [Incr] ticked in registry will be executed"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 2: MAIN WORKSPACE GRID (Left: Registry | Right: Specs)
        ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"   MinWidth="380"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="460" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────────────────────────────
                 LEFT COLUMN: Models Registry Card
            ──────────────────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="16,12,4,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Toolbar -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Card Toolbar with Search Filter -->
                    <Border Grid.Row="0"
                            Background="{StaticResource ToolbarBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0"
                            Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top row: Title and Action Buttons -->
                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="TEKLA MODEL REGISTRY"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,16,0"/>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="＋  Add Model"
                                            Command="{Binding AddCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            IsEnabled="{Binding IsNotBusy}"
                                            ToolTip="Add a new Tekla model configuration"
                                            Margin="0,0,6,0"/>
                                    <Button Content="✎  Edit"
                                            Command="{Binding EditCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="Edit selected model paths"
                                            Margin="0,0,6,0"/>
                                    <Button Content="✕  Remove"
                                            Command="{Binding DeleteCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            ToolTip="Remove selected model from registry (no files deleted)"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Bottom row: Search / Quick Filter Bar -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource SurfaceDarkBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="🔍"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             CaretBrush="{StaticResource AccentCyanBrush}"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Filter models in real-time by name, source directory, or target"/>

                                    <!-- Watermark placeholder when empty -->
                                    <TextBlock Grid.Column="1"
                                               Text="Search models by name or path…"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="2,0,0,0"
                                               Visibility="{Binding HasSearchText, Converter={StaticResource InverseBoolToVisibility}}"/>

                                    <!-- Clear Search Button -->
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            Command="{Binding ClearSearchCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="6,1"
                                            FontSize="9"
                                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Clear search filter"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ModelsView}"
                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <!-- Auto-Backup Inclusion Checkbox Column -->
                            <DataGridTemplateColumn Width="48">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Auto" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="Scheduled Auto-Backup: Check to include in interval backups"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding EnableAutoBackup, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Include this model in automated scheduled backups"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Incremental Sync Inclusion Checkbox Column -->
                            <DataGridTemplateColumn Width="48">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Incr" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="Live Incremental Sync: Check to include in session sync"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding EnableIncrementalBackup, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Include this model in live session incremental sync"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Model Name"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"    Value="12,9"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Source Folder"
                                                Binding="{Binding SourcePath}"
                                                Width="1.6*"
                                                MinWidth="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"         Value="12,9"/>
                                        <Setter Property="Foreground"      Value="{StaticResource SecondaryTextBrush}"/>
                                        <Setter Property="TextTrimming"    Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip"         Value="{Binding LiveModelPath}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Last Reserve"
                                                Binding="{Binding LastReserveBackupDisplay}"
                                                Width="125">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"    Value="12,9"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryLightBrush}"/>
                                        <Setter Property="FontSize"   Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Last Checker"
                                                Binding="{Binding LastCheckerBackupDisplay}"
                                                Width="125">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"    Value="12,9"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryLightBrush}"/>
                                        <Setter Property="FontSize"   Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Last Incremental"
                                                Binding="{Binding LastIncrementalBackupDisplay}"
                                                Width="125">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"    Value="12,9"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentTealBrush}"/>
                                        <Setter Property="FontSize"   Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"/>

            <!-- ─────────────────────────────────────────────────────────
                 RIGHT COLUMN: Specifications & Mode Card Controls
            ──────────────────────────────────────────────────────────── -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="4,12,16,10">
                <Grid>
                    <!-- Empty State: No Model Selected -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding SelectedModel,
                                             Converter={StaticResource NullToVisibilityInverse}}">
                        <Border Width="56" Height="56"
                                CornerRadius="28"
                                Background="#0A1830"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14">
                            <TextBlock Text="📋" FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Select a Model from Registry"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Select an entry to configure replication targets and execute backup."
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="260"/>
                    </StackPanel>

                    <!-- Active Model Selected -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="18,16"
                                  Visibility="{Binding SelectedModel,
                                               Converter={StaticResource NullToVisibility}}">
                        <StackPanel>

                            <!-- Header: Model Name & Actions -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding SelectedModel.Name}"
                                           FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="240"/>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="▶ Tekla"
                                            Command="{Binding LaunchSelectedModelInTeklaCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="10,4"
                                            FontSize="10"
                                            Margin="0,0,6,0"
                                            ToolTip="Directly launch this model inside Tekla Structures"/>
                                    <Button Content="📁 Open"
                                            Command="{Binding OpenSourceFolderCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,4"
                                            FontSize="10"
                                            Margin="0,0,8,0"
                                            ToolTip="Open model folder in Windows Explorer"/>
                                    <Border Background="#0A223E"
                                            BorderBrush="{StaticResource AccentCyanBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="READY"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentCyanBrush}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <!-- ── SECTION 1: CALCULATION / REPLICATION MODE ── -->
                            <TextBlock Text="REPLICATION MODE (KNOWN TARGETS)"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- 2-Column Mode Card Grid (Matching screenshot style) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Reserve Backup -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding CreateReserveBackup}"
                                          IsEnabled="{Binding IsNotBusy}"
                                          Style="{StaticResource ModeCardCheckBoxStyle}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="🗄  Reserve (Type 1)"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Border DockPanel.Dock="Right"
                                                    Background="#102545"
                                                    CornerRadius="4"
                                                    Padding="4,1">
                                                <TextBlock Text="SYNC" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryLightBrush}"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Automated incremental project mirror"
                                                   FontSize="10"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <!-- Card 2: Checker Backup -->
                                <CheckBox Grid.Column="2"
                                          IsChecked="{Binding CreateCheckerBackup}"
                                          IsEnabled="{Binding IsNotBusy}"
                                          Style="{StaticResource ModeCardCheckBoxStyle}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="✅  Checker (Type 2)"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Border DockPanel.Dock="Right"
                                                    Background="#102545"
                                                    CornerRadius="4"
                                                    Padding="4,1">
                                                <TextBlock Text="REPLICA" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryLightBrush}"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="Independent checker validation target"
                                                   FontSize="10"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Grid>

                            <!-- ── SECTION 1B: BACKUP CONFIGURATION & SUFFIX ── -->
                            <Border Background="{StaticResource SurfaceDarkBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="⚙  BACKUP OPTIONS &amp; SUFFIX"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <CheckBox DockPanel.Dock="Right"
                                                  Content="Include *.bak files"
                                                  IsChecked="{Binding IncludeBakFiles, Mode=TwoWay}"
                                                  FontSize="10"
                                                  Foreground="{StaticResource PrimaryLightBrush}"
                                                  ToolTip="When unchecked (recommended), Tekla *.bak backup files are excluded to save disk space"/>
                                    </DockPanel>

                                    <!-- Target Folder Suffix -->
                                    <TextBlock Text="TARGET FOLDER SUFFIX"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding TargetFolderSuffix, UpdateSourceTrigger=PropertyChanged}"
                                             GotFocus="OnSuffixGotFocus"
                                             LostFocus="OnSuffixLostFocus"
                                             TextChanged="OnSuffixTextChanged"
                                             ToolTip="Suffix appended to the model name folder (e.g. QC, RevA, Backup) to prevent clash with live model"
                                             Padding="8,6"
                                             FontSize="11"
                                             Margin="0,0,0,3"/>
                                    <TextBlock Text="Suffix is auto-prefixed with '_' and appended after HHmm to avoid clash when live &amp; backup models are open."
                                               FontSize="9"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Inquire Backups Button -->
                            <Button Content="🔍  Inquire Today's Backups &amp; Check Integrity"
                                    Command="{Binding InquireBackupsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,8"
                                    Margin="0,0,0,10"/>

                            <!-- ── SECTION 4: ACTION CTA BUTTON ── -->
                            <Button Content="▶   EXECUTE MODEL REPLICATION"
                                    Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource CreateBackupButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,4,0,0"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 3: PROGRESS BAR PANEL (Visible only when IsBusy)
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource AccentCyanBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="16,0,16,8"
                Padding="16,10"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="11"
                               Foreground="{StaticResource PrimaryLightBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6"/>
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercentage, Mode=OneWay}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource AccentCyanBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="⏹  Cancel"
                        Command="{Binding CancelBackupCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Padding="14,6"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 4: STATUS BAR (Dark Inset Footer)
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <DockPanel LastChildFill="True">
                <!-- Config Path & Build Version on Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppVersion, StringFormat='Build {0}'}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryLightBrush}"
                               Margin="0,0,12,0"/>
                    <TextBlock Text="|"
                               FontSize="10"
                               Foreground="{StaticResource CardBorderBrush}"
                               Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ConfigFilePath, StringFormat='Config: {0}'}"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               ToolTip="{Binding ConfigFilePath}"/>
                </StackPanel>

                <!-- Status Message on Left with glowing dot -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="● "
                               FontSize="10"
                               Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{StaticResource PrimaryLightBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             FLOATING TOAST NOTIFICATION BANNER OVERLAY
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,60,24,0"
                MaxWidth="420"
                Panel.ZIndex="999"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
            </Border.Effect>
            <Border Background="#0B162C"
                    BorderBrush="{StaticResource AccentCyanBrush}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="🔔"
                               FontSize="18"
                               VerticalAlignment="Top"
                               Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToastTitle}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding ToastMessage}"
                                   FontSize="11"
                                   Foreground="{StaticResource PrimaryLightBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="✕"
                            Command="{Binding DismissToastCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="6,2"
                            FontSize="10"
                            VerticalAlignment="Top"
                            Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
