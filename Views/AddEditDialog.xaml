<Window x:Class="ModelCopier.Views.AddEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="660" Height="580"
        MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        Background="{StaticResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title bar -->
            <RowDefinition Height="*"/>     <!-- form      -->
            <RowDefinition Height="Auto"/>  <!-- error     -->
            <RowDefinition Height="Auto"/>  <!-- buttons   -->
        </Grid.RowDefinitions>

        <!-- ── Title bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30"
                        CornerRadius="8"
                        Background="{StaticResource NeumorphicSunkenBrush}"
                        BorderBrush="{StaticResource NeumorphicButtonBorderBrush}"
                        BorderThickness="1.2"
                        Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="315" Color="#020408" Opacity="0.6"/>
                    </Border.Effect>
                    <TextBlock Text="⚙" FontSize="14" Foreground="{StaticResource AccentCyanBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding WindowTitle}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource AccentCyanBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Form ───────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Model Name -->
                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Model Name" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <TextBlock Text="(required)"  FontSize="9" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Descriptive name shown in the model list"/>

                <!-- Source Folder -->
                <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Source Repository" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <TextBlock Text="(parent root)"    FontSize="9" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                    <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Parent repository where the model folder resides (e.g. D:\LiveModels). The application only copies the model subfolder."/>
                    <TextBlock Text="{Binding LiveModelPathPreview, StringFormat='Model Folder: {0}'}"
                               FontSize="10" Foreground="{StaticResource AccentCyanBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="2,3,0,0"/>
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse…"
                        Command="{Binding BrowseSourceCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,6"
                        VerticalAlignment="Top"
                        Height="32"/>

                <!-- Reserve Target -->
                <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Reserve Target" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <TextBlock Text="(Type 1 Archive)" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding ReserveTargetPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Root folder where Reserve (Type 1) backups will be placed"
                         Margin="0,0,8,0"/>
                <Button Grid.Row="4" Grid.Column="2" Content="Browse…"
                        Command="{Binding BrowseReserveCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,6"
                        VerticalAlignment="Stretch"/>

                <!-- Checker Target -->
                <StackPanel Grid.Row="6" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Checker Target" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <TextBlock Text="(Type 2 Verification)" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <TextBox Grid.Row="6" Grid.Column="1"
                         Text="{Binding CheckerTargetPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Root folder where Checker (Type 2) backups will be placed"
                         Margin="0,0,8,0"/>
                <Button Grid.Row="6" Grid.Column="2" Content="Browse…"
                        Command="{Binding BrowseCheckerCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,6"
                        VerticalAlignment="Stretch"/>

                <!-- Incremental Target -->
                <StackPanel Grid.Row="8" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Incremental Target" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <TextBlock Text="(Type 3 Live Sync)" FontSize="9" Foreground="{StaticResource AccentCyanBrush}"/>
                </StackPanel>
                <TextBox Grid.Row="8" Grid.Column="1"
                         Text="{Binding IncrementalTargetPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Separate folder where modified files are synchronized at set intervals during the session"
                         Margin="0,0,8,0"/>
                <Button Grid.Row="8" Grid.Column="2" Content="Browse…"
                        Command="{Binding BrowseIncrementalCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,6"
                        VerticalAlignment="Stretch"/>

                <!-- Target Folder Suffix -->
                <StackPanel Grid.Row="10" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Folder Suffix" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <TextBlock Text="(appended to model)" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding TargetFolderSuffix, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Suffix appended to the model name folder (e.g., Model_QC) to prevent collision with live model"/>

                <!-- File Options: Include *.bak -->
                <StackPanel Grid.Row="12" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="File Options" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                </StackPanel>
                <CheckBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2"
                          IsChecked="{Binding IncludeBakFiles, Mode=TwoWay}"
                          Content="Include *.bak files (Tekla auto-backups)"
                          ToolTip="When unchecked (recommended), Tekla *.bak files are skipped to save disk space."/>

                <!-- Automation Selection -->
                <StackPanel Grid.Row="14" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Automation" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2">
                    <CheckBox IsChecked="{Binding EnableAutoBackup, Mode=TwoWay}"
                              Content="Enable Scheduled Auto-Backup for this model"
                              ToolTip="When checked, scheduled interval full backups will include this model."
                              Margin="0,0,0,4"/>
                    <CheckBox IsChecked="{Binding EnableIncrementalBackup, Mode=TwoWay}"
                              Content="Enable Live Incremental Sync for this model"
                              ToolTip="When checked, live session incremental sync will copy modified files for this model."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ── Validation error ───────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource DangerBgBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="22,0,22,8"
                Padding="12,8"
                Visibility="{Binding IsValidationErrorVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ValidationError}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ── Dialog buttons ─────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="OnCancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="90"
                        Margin="0,0,10,0"/>
                <Button Content="OK"
                        Click="OnOk"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="90"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
