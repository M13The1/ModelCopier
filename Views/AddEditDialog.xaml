<Window x:Class="ModelCopier.Views.AddEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="620" Height="380"
        MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title bar -->
            <RowDefinition Height="*"/>     <!-- form      -->
            <RowDefinition Height="Auto"/>  <!-- error     -->
            <RowDefinition Height="Auto"/>  <!-- buttons   -->
        </Grid.RowDefinitions>

        <!-- ── Title bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="20,14">
            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="16" FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- ── Form ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Model Name -->
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Model Name" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                <TextBlock Text="(required)"  FontSize="9" Foreground="#90A4AE"/>
            </StackPanel>
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Descriptive name shown in the model list"/>

            <!-- Source Folder -->
            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Source Folder" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                <TextBlock Text="(required)"    FontSize="9" Foreground="#90A4AE"/>
            </StackPanel>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Full path of the Tekla model folder to copy from"
                     Margin="0,0,6,0"/>
            <Button Grid.Row="2" Grid.Column="2" Content="Browse…"
                    Command="{Binding BrowseSourceCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Stretch"/>

            <!-- Reserve Target -->
            <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Reserve Target" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                <TextBlock Text="(Type 1)"       FontSize="9" Foreground="#90A4AE"/>
            </StackPanel>
            <TextBox Grid.Row="4" Grid.Column="1"
                     Text="{Binding ReserveTargetPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Root folder where Reserve (Type 1) backups will be placed"
                     Margin="0,0,6,0"/>
            <Button Grid.Row="4" Grid.Column="2" Content="Browse…"
                    Command="{Binding BrowseReserveCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Stretch"/>

            <!-- Checker Target -->
            <StackPanel Grid.Row="6" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Checker Target" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                <TextBlock Text="(Type 2)"       FontSize="9" Foreground="#90A4AE"/>
            </StackPanel>
            <TextBox Grid.Row="6" Grid.Column="1"
                     Text="{Binding CheckerTargetPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Root folder where Checker (Type 2) backups will be placed"
                     Margin="0,0,6,0"/>
            <Button Grid.Row="6" Grid.Column="2" Content="Browse…"
                    Command="{Binding BrowseCheckerCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Stretch"/>
        </Grid>

        <!-- ── Validation error ───────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#FFF3E0"
                BorderBrush="#FF6F00"
                BorderThickness="0,0,0,0"
                CornerRadius="4"
                Margin="20,0,20,6"
                Padding="10,6"
                Visibility="{Binding IsValidationErrorVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ValidationError}"
                       Foreground="#E65100"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ── Dialog buttons ─────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{StaticResource ToolbarBgBrush}"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="OnCancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="90"
                        Margin="0,0,8,0"/>
                <Button Content="OK"
                        Click="OnOk"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="90"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
