<Window x:Class="ModelCopier.Views.InquireBackupsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Verification &amp; Inspection"
        Width="780" Height="560"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{StaticResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="Auto"/> <!-- Live Model Stats Bar -->
            <RowDefinition Height="*"/>    <!-- Backups Split View / Lists -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- ── Title Header ────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="🔄 Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,5"
                        VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30"
                            CornerRadius="6"
                            Background="#091529"
                            BorderBrush="{StaticResource AccentCyanBrush}"
                            BorderThickness="1"
                            Margin="0,0,12,0">
                        <TextBlock Text="🔍" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Today's Backups Inspection"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource AccentCyanBrush}"/>
                        <TextBlock Text="{Binding ModelName, StringFormat='Model: {0}'}"
                                   FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Live Model Stats Bar ───────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceDarkBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="LIVE SOURCE MODEL"
                               FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <DockPanel LastChildFill="True" Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="▶ Open in Tekla"
                                Command="{Binding LaunchInTeklaCommand}"
                                CommandParameter="{Binding SourcePath}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="8,3"
                                FontSize="10"
                                Margin="10,0,0,0"
                                ToolTip="Launch this model directly in Tekla Structures"/>
                        <TextBlock Text="{Binding SourcePath}"
                                   FontSize="11" Foreground="{StaticResource PrimaryLightBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding SourcePath}"/>
                    </DockPanel>
                </StackPanel>

                <!-- Stat 1: Subfolders -->
                <Border Grid.Column="1"
                        Background="#0D182A"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="12,0,6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SUBFOLDERS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LiveSubFolderCount}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Stat 2: Active Files -->
                <Border Grid.Column="2"
                        Background="#0D182A"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ACTIVE FILES" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LiveFileCount}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Stat 3: .bak Excluded -->
                <Border Grid.Column="3"
                        Background="#0D182A"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text=".BAK EXCLUDED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LiveBakCount}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── Backups Split View ─────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Reserve Backups -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource ToolbarBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗄  RESERVE BACKUPS (TODAY)"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryLightBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1"
                               Text="No Reserve backups recorded for today."
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasReserveBackups, Converter={StaticResource InverseBoolToVisibility}}"/>

                    <!-- List of Reserve snapshots -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReserveBackups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceDarkBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="8,6"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FolderName}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding FileCount, StringFormat='Files: {0}'}"
                                                               FontSize="10" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding SubFolderCount, StringFormat='Subfolders: {0}'}"
                                                               FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▶ Tekla"
                                                        Command="{Binding DataContext.LaunchInTeklaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding FullPath}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="8,4"
                                                        FontSize="10"
                                                        Margin="0,0,4,0"
                                                        ToolTip="Open this backup model directly in Tekla Structures"/>
                                                <Button Content="📁 Open"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding FullPath}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8,4"
                                                        FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: Checker Backups -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource ToolbarBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅  CHECKER BACKUPS (TODAY)"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryLightBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1"
                               Text="No Checker backups recorded for today."
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasCheckerBackups, Converter={StaticResource InverseBoolToVisibility}}"/>

                    <!-- List of Checker snapshots -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CheckerBackups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceDarkBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="8,6"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FolderName}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding FileCount, StringFormat='Files: {0}'}"
                                                               FontSize="10" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding SubFolderCount, StringFormat='Subfolders: {0}'}"
                                                               FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▶ Tekla"
                                                        Command="{Binding DataContext.LaunchInTeklaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding FullPath}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="8,4"
                                                        FontSize="10"
                                                        Margin="0,0,4,0"
                                                        ToolTip="Open this backup model directly in Tekla Structures"/>
                                                <Button Content="📁 Open"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding FullPath}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8,4"
                                                        FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Bottom Buttons ─────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close"
                        Click="OnClose"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="90"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
